{
  "name": "cyberhub-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.10"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "db:generate": "pnpm --filter @cyberhub/database exec prisma generate",
    "db:migrate": "pnpm --filter @cyberhub/database exec prisma migrate dev",
    "db:seed": "pnpm --filter @cyberhub/database run seed",
    "db:studio": "pnpm --filter @cyberhub/database exec prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "rimraf": "^6.0.1"
  }
}
