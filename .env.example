# ─── Ambiente ────────────────────────────────────────────
NODE_ENV=development
TZ=America/Sao_Paulo

# ─── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=cyberhub
POSTGRES_PASSWORD=cyberhub_dev_password
POSTGRES_DB=cyberhub
DATABASE_URL=postgresql://cyberhub:cyberhub_dev_password@localhost:5432/cyberhub?schema=public

# ─── Redis ───────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=cyberhub_redis_dev

# ─── API ─────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGINS=http://localhost:3000

# JWT (gerar secrets reais em prod: openssl rand -base64 48)
JWT_ACCESS_SECRET=trocar_em_producao_access_secret_min_32_chars
JWT_REFRESH_SECRET=trocar_em_producao_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── Discord Bot ─────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# API Key do bot (gerada pelo seed, vai no header x-api-key)
# Defina p/ o seed criar o usuário bot (>=16 chars). Dev: cyberhub_dev_api_key_123
CYBERHUB_API_KEY=cyberhub_dev_api_key_123
# Webhook do canal Discord pra AlertsModule (disparo automático de alertas)
# Crie em: Discord → canal → Integrações → Webhooks → New Webhook → copie a URL
DISCORD_ALERT_WEBHOOK_URL=
# Canal genérico WEBHOOK dos alertas (qualquer URL que aceite POST JSON). Opcional.
ALERT_WEBHOOK_URL=

# ─── Alertas via EMAIL (SMTP) — opcional, só se usar channel EMAIL ────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=admin@cyberhub.ai
ALERT_EMAIL_TO=

# ─── n8n ─────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cyberhub_n8n_dev
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
# Segredo HMAC p/ validar webhooks n8n→API (openssl rand -hex 32)
N8N_WEBHOOK_SECRET=trocar_em_producao_n8n_webhook_secret_min_32_chars

# ─── IA (Hermes via Ollama) ──────────────────────────────
AI_PROVIDER=hermes
HERMES_BASE_URL=http://localhost:11434
HERMES_MODEL=hermes3

# ─── Threat Intel (opcionais em dev; sem key o adapter é pulado) ───
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=

# ─── Storage de relatórios ───────────────────────────────
REPORTS_STORAGE_PATH=./data/reports
