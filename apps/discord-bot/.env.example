# ─── Discord Bot ─────────────────────────────────────────
# Token do bot (Discord Developer Portal → Bot → Token)
DISCORD_BOT_TOKEN=
# Client ID / Application ID (Discord Developer Portal → General Information)
DISCORD_CLIENT_ID=
# ID do servidor (guild) onde registrar os comandos. Right-click no servidor → Copy Server ID
GUILD_ID=

# ─── CyberHub API ────────────────────────────────────────
# URL da API CyberHub (default dev: http://localhost:3001)
API_BASE_URL=http://localhost:3001
# API Key do usuário BOT (header x-api-key). Seed dev: cyberhub_dev_api_key_123
API_KEY=cyberhub_dev_api_key_123
